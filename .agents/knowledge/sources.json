{
  "sources": {
    "internals": {
      "type": "source-code",
      "default_path": "../..",
      "description": "Internal implementation details of AISuper Platform",
      "respect_gitignore": true,
      "languages": {
        "kotlin": {
          "include": [
            "kotlin/androidApp/**/*.kt",
            "kotlin/applet-provider/**/*.kt",
            "kotlin/composeApp/**/*.kt",
            "kotlin/iosApp/**/*.kt",
            "kotlin/kotlin-js-store/**/*.kt",
            "kotlin/lanternaApp/**/*.kt",
            "kotlin/server/**/*.kt",
            "kotlin/shared/**/*.kt"
          ],
          "exclude": []
        },
        "typescript": {
          "include": [
            "client-react/**/*.ts",
            "client-react/**/*.tsx",
            "modules-ts/**/*.ts",
            "tinyjs-app/types/**/*.ts"
          ],
          "exclude": []
        },
        "javascript": {
          "include": [
            "tinyjs-app/src/**/*.js"
          ],
          "exclude": [
            "tinyjs-app/src/frontend/assets/**"
          ]
        }
      }
    },
    "externals": {
      "type": "source-code",
      "default_path": "../..",
      "description": "External interfaces and templates for Applet developers",
      "respect_gitignore": true,
      "languages": {
        "typescript": {
          "include": [
            "template/**/*.ts",
            "template/**/*.tsx",
            "template/**/*.js",
            ".agents/sample-applets/**/*.ts",
            ".agents/sample-applets/**/*.tsx",
            ".agents/sample-applets/**/*.js"
          ],
          "exclude": []
        }
      }
    }
  }
}
